{{page-title "Schedule"}}
<div class="schedule-page">
  <div class="row">
    <div class="col-xs-12 col-lg-8">
      <h2 class="schedule-header">Schedule - {{moment-format this.currentDate 'LL'}}</h2>
    </div>
    <div class="col-xs-12 col-lg-4">
      <div class="schedule-date-picker">
        <a class="picker glyphicon glyphicon-triangle-left" aria-hidden="true"
          {{action 'prevDay' }}>
        </a>
        <PikadayInput @onSelection={{action 'changeDate'}} @value={{this.currentDate}} @format='YYYY-MM-DD' />
        <a class="picker glyphicon glyphicon-triangle-right" aria-hidden="true"
          {{action 'nextDay' }}>
        </a>
      </div>
    </div>
  </div>
  <div class="schedule-wrapper clearfix">
    <div class="col-xs-12">
      <ShowsSchedule @items={{filteredRuns}} class="shows-schedule is-desktop" />
    </div>
  </div>
  <div class="social-wrapper">
    <FbShareButton>Share</FbShareButton>
    <TwitterShareButton>Tweet</TwitterShareButton>
  </div>
</div>
