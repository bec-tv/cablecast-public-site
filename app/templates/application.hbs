{{page-title this.model.pageTitle}}
<HeadLayout />
<NavMenu @siteConfig={{this.model}} @onSearch={{action "navSearch"}} />
<div class="container-wrapper">
  <div class="container">
    {{outlet}}
    <hr>
  </div>
</div>
<ChannelFooter @config={{this.model}} @hasPodcasts={{this.model.hasPodcasts}} @publicChannels={{this.model.publicChannels}} @showOtherChannels={{this.model.showOtherChannels}} />
<UpdateChannelStyles @channel-id={{this.model.channel.id}} />
