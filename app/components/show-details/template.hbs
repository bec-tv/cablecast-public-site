<div ...attributes>
  {{#each this.fieldDisplays as |fd|}}
    {{#unless (or (eq fd.widget 'pdf') (eq fd.widget 'iframe'))}}
      <div class="show-field-display {{unless (eq fd.widget) "block-text" "u-truncate-text"}}">
        <label>
          {{fd.label}}
        </label>
        {{#if (eq fd.widget "link")}}
          <a href={{fd.value}} target="_blank" rel="noopener noreferrer">
            {{fd.value}}
          </a>
        {{else if (eq fd.widget "block-text")}}
          <p>
            {{fd.value}}
          </p>
        {{else}}
          {{fd.value}}
        {{/if}}
      </div>
    {{/unless}}
  {{/each}}
</div>
