<div class="show-stub-full-text" ...attributes>
  {{#if @show.thumbnailUrl}}
    <LinkTo @route="show" @model={{@show.showId}} @query={{hash seekto=show.hit.offset}} class="thumbnail-responsive">
      <img src="{{@show.thumbnailUrl}}?d=256x144" class="img-response" />
    </LinkTo>
  {{else}}
    <div class="thumbnail-responsive"></div>
  {{/if}}
  <div>
  <h3 class="show-stub-title-header u-break-text">
    <LinkTo @route="show" @model={{@show.showId}} @query={{hash seekto=show.hit.offset}} class="show-stub-title-link">{{{titleHighlight}}}</LinkTo>
  </h3>
  {{#if @show.hit}}
    <ShowHit @hit={{show.hit}} @showId={{show.showId}} @search={{search}} @terms={{@terms}}/>
  {{/if}}
  </div>
</div>
