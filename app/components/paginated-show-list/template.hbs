<div class="paginated-show-list" ...attributes>
  <div class="search-page">
    <div class="row">
      <div class="col-xs-12">
        <h1 class="search-results-header">
          {{@title}}</h1>
          <div class="show-display-number">
          {{#if this.showPaginationControl}}
            
              Displaying
              {{this.firstResult}}
              -
              {{this.lastResult}}
              of
              {{@meta.count}}
              {{#if (eq @meta.count 1)}}
                result.
              {{else}}
                results.
              {{/if}}
            
          {{else}}
            
              Displaying
              {{@shows.length}}
              {{#if (eq @shows.length 1)}}
                result.
              {{else}}
                results.
              {{/if}}
            
          {{/if}}
          </div>
      </div>
    </div>
    <div class="show-player clearfix">
      <div class="col-lg-12 u-no-padding">
        {{#if this.showPaginationControl}}
          <PaginationControl
            @onPageSelect={{action "_goToPage"}}
            @pageSize={{@pageSize}}
            @currentPage={{@page}}
            @count={{@total}}
            class="text-center"
          />
        {{/if}}
        <div class="show-stub-container">
          {{#if @loading}}
            <LoadingSpinner />
          {{else}}
            {{#each @shows as |result|}}
              {{#if @useFullText}}
                <ShowStubFullText @show={{result}} @search={{search}}/>
              {{else}}
                <ShowStub @show={{result}}/>
              {{/if}}
            {{else}}
              <h3>
                Your search returned no results.
              </h3>
            {{/each}}
          {{/if}}
        </div>
        {{#if this.showPaginationControl}}
          <PaginationControl
            @onPageSelect={{action "_goToPage"}}
            @pageSize={{@pageSize}}
            @currentPage={{@page}}
            @count={{@total}}
            class="text-center"
          />
        {{/if}}
      </div>
    </div>
  </div>
</div>