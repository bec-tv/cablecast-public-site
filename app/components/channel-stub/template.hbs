<div class="channel-stub" ...attributes>
  <a href="/CablecastPublicSite?site={{otherSite.siteId}}" class="channel-stub-link">
    <p class="channel-stub-title">
      {{otherSite.title}}
    </p>
    <div class="channel-stub-logo">
      {{#if this.logo}}
        <img src="{{this.logo}}?d=200x200&fit_mode=scale" class="img img-responsive" alt="Logo">
      {{else}}
        <img
          src="{{this.rootURL}}images/temp-peg-logo.png"
          class="img img-responsive"
          alt="Logo"
        >
      {{/if}}
    </div>
    {{!--<p>{{{otherSite.pageDescription}}}</p>--}}
  </a>
</div>