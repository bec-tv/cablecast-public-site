<div ...attributes>
  <div class="schedule-row clearfix">
    <div class="plaque">
      <LinkTo @route="show" @model={{@item.showId}}>
        {{#if this.isOnAir}}
          <div class="plaque-content now">
            Now
          </div>
        {{else}}
          <div class="plaque-content not-now">
            {{moment-format (local-time @item.runDateTime) "hh:mm a"}}
          </div>
        {{/if}}
      </LinkTo>
    </div>
    <div class="schedule-container">
      <div class="play-icon is-desktop">
        <LinkTo @route="show" @model={{@item.showId}} @alt={{@item.show.title}}>
          <span
            class="glyphicon glyphicon-play play-icon-link"
            aria-hidden="true"
            title="Watch now"
          ></span>
        </LinkTo>
      </div>
      <div
        class="schedule-title {{unless this.media.isLg "is-mobile"}} u-truncate-text"
        title="{{@item.show.title}}"
      >
        <LinkTo @route="show" @model={{@item.showId}} @alt={{@item.show.title}} class="show-link">
          {{@item.show.title}}
        </LinkTo>
      </div>
    </div>
  </div>
</div>
