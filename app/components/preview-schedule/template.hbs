<div ...attributes>
  <h3 class="schedule-preview-header">
    Schedule
  </h3>
  <div class="schedule">
    {{#each this.filteredRuns as |run|}}
      <div class="schedule-row clearfix">
        <div class="plaque">
          {{#if (eq run this.onAirRun)}}
            <!-- TODO live
            <LinkTo
              @route="watch-now"
              @model={{@channel.liveUrl}}
              @alt={{this.onAirRun.show.title}}
              class="live-stream-name">
              <div class="plaque-content now">
                Now
              </div>
            </LinkTo>
            -->
            <div class="plaque-content now">
              Now
            </div>
          {{else}}
            <LinkTo @route="show" @model={{run.showId}}>
              <div class="plaque-content not-now">
                {{moment-format (local-time run.runDateTime) "h:mm a"}}
              </div>
            </LinkTo>
          {{/if}}
        </div>
        <div class="schedule-container u-truncate-text">
          <LinkTo @route="show" @model={{run.showId}}>
            {{run.title}}
          </LinkTo>
        </div>
      </div>
    {{/each}}
  </div>
  <LinkTo @route="schedule" class="btn btn-schedule">See the entire schedule</LinkTo>
</div>
