<div ...attributes>
  <div class="footer-wrapper">
    <div class="container">
      <div class="row">
        <div class="col-md-8">
          <h1 class="footer-header">
            {{@siteConfig.pageShortDescription}}
          </h1>
          <p>
            {{{@siteConfig.pageDescription}}}
          </p>
          {{#if (gt @siteConfig.otherSites.length 0)}}
            <h2 class="public-site-links-title">
              {{#if (gt @siteConfig.otherSites.length 1)}}
                Browse our other channels
              {{else}}
                Browse our other channel
              {{/if}}
            </h2>
            <div class="channel-stub-container">
              {{#each @siteConfig.otherSites as |otherSite|}}
                <ChannelStub @otherSite={{otherSite}} />
              {{/each}}
            </div>
          {{/if}}
        </div>
        <div class="col-md-4">
          <h1 class="footer-header">
            Contact Us
          </h1>
          <ContactUs @config={{@siteConfig}} @hasPodcasts={{@siteConfig.hasPodcasts}} />
        </div>
      </div>
    </div>
  </div>
</div>
